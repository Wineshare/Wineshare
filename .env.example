# Copiez ce fichier en .env.local pour tester le formulaire en local (npm run dev),
# et renseignez les mêmes variables sur Vercel (Settings > Environment Variables).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=contact@wineshare.fr
CONTACT_FROM_EMAIL=WineShare <contact@wineshare.fr>

# Back-office (/admin) : mot de passe d'accès aux statistiques
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long

# Base Upstash Redis (ajoutées automatiquement par Vercel > Storage ; à copier ici pour tester en local)
WINESHARE_KV_REST_API_URL=https://xxxxx.upstash.io
WINESHARE_KV_REST_API_TOKEN=xxxxxxxx
